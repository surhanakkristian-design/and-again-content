{
 "lang": "sk",
 "stories": {
  "8055": [
   "Tom zmeškal autobus,",
   "tak schmatol lano prelietavajúceho balóna.",
   "Celú cestu do práce sa ho držal."
  ],
  "236": [
   "Miina loď pretekala s delfínom.",
   "Delfín ľahko vyhral,",
   "tak vyskočil vysoko do vzduchu, aby to oslávil!"
  ],
  "7071": [
   "Unavený zo svojho zlatého koča,",
   "starý kráľ si požičal záhradníkovu štvorkolku.",
   "Špliechal cez každú mláku a smial sa ako malý chlapec."
  ],
  "62": [
   "Sam zbalil piknikovú tašku.",
   "Pridal jablká, chlieb a veľkú fľašu vody.",
   "Teraz ju nevládal zdvihnúť!"
  ],
  "8039": [
   "Anna prekopala priechod snehom.",
   "Jej husky sa pretlačil okolo a ako prvý ním prebehol.",
   "Vnútri sa otec zasmial: „Pekný priechod pre psa!“"
  ],
  "900001": [
   "Maxovi trvalo päť minút, kým si vybral jednu šišku.",
   "Jeho kamarátku čakanie omrzelo.",
   "Tak sa načiahla ponad sklo a schmatla tri."
  ],
  "900002": [
   "Medveď Bruno hral na violončele klasickú hudbu.",
   "Líška sa pridala na husliach.",
   "Duet bol taký hlasný, že sa luster zatriasol!"
  ]
 },
