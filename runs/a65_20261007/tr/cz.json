   "Unavený ze svého zlatého kočáru,",
   "starý král si půjčil zahradníkovu čtyřkolku.",
   "Šplouchal v každé louži a smál se jako malý kluk."
  ],
  "62": [
   "Sam sbalil piknikovou tašku.",
   "Přidal jablka, chleba a velkou láhev vody.",
   "Teď ji nemohl zvednout!"
  ],
  "8039": [
   "Anna prohrnula průchod sněhem.",
   "Její husky se protáhl kolem a proběhl jím jako první.",
   "Uvnitř se táta zasmál: „Pěkná cestička pro psa!“"
  ],
  "900001": [
   "Maxovi trvalo pět minut, než si vybral jeden donut.",
   "Jeho kamarádku už čekání omrzelo.",
   "Tak se natáhla přes sklo a popadla tři."
  ],
  "900002": [
   "Medvěd Bruno hrál na violoncello klasickou hudbu.",
   "Liška se přidala na housle.",
   "Duet byl tak hlasitý, že se lustr otřásl!"
