  "8055": [
   "Tomovi ujel autobus,",
   "tak chytil lano prolétajícího balonu.",
   "Držel se ho celou cestu do práce."
  ],
  "236": [
   "Miina loď závodila s delfínem.",
   "Delfín snadno vyhrál,",
   "a tak vyskočil vysoko do vzduchu, aby to oslavil!"
  ],
