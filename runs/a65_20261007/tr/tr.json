 "stories": {
  "8055": [
   "Tom otobüsü kaçırdı,",
   "bu yüzden yanından geçen bir balonun ipini yakaladı.",
   "İşe giderken yol boyunca ona tutundu."
  ],
  "236": [
   "Mia'nın teknesi bir yunusla yarıştı.",
   "Yunus kolayca kazandı,",
   "bu yüzden kutlamak için havaya doğru yükseğe zıpladı!"
  ],
  "7071": [
   "Altın arabasından bıkan",
   "yaşlı kral bahçıvanın ATV'sini ödünç aldı.",
   "Her su birikintisinin içinden sıçrayarak geçti ve küçük bir çocuk gibi güldü."
  ],
  "62": [
   "Sam bir piknik çantası hazırladı.",
   "İçine elma, ekmek ve büyük bir şişe su koydu.",
   "Artık onu kaldıramıyordu!"
  ],
  "8039": [
   "Anna karda bir geçit açtı.",
   "Husky'si yanından sıkışarak geçti ve geçitten ilk o koştu.",
   "İçeride babası güldü: “Köpek için güzel bir patika!”"
  ],
  "900001": [
   "Max tek bir donut seçmek için beş dakika harcadı.",
   "Arkadaşı beklemekten sıkıldı.",
   "Bu yüzden camın üzerinden uzanıp üç tane kaptı."
  ],
  "900002": [
   "Ayı Bruno çellosunda klasik müzik çaldı.",
   "Bir tilki kemanla ona katıldı.",
   "Düet o kadar gürültülüydü ki avize titredi!"
  ]
 },
